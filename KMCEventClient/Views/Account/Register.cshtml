@model RegisterOrganizerViewModel
@{
    ViewData["Title"] = "Register Organizer";
}
<section class="section"><div class="container narrow"><div class="form-card"><span class="eyebrow">Organizer registration</span><h1>Create an organizer account</h1><p>Register before creating and managing events on the KMC platform.</p><form asp-action="Register" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="field"><label asp-for="OrganizerName"></label><input asp-for="OrganizerName" /><span asp-validation-for="OrganizerName"></span></div><div class="field"><label asp-for="OrganizationName"></label><input asp-for="OrganizationName" /><span asp-validation-for="OrganizationName"></span></div><div class="field"><label asp-for="Email"></label><input asp-for="Email" /><span asp-validation-for="Email"></span></div><div class="field"><label asp-for="PhoneNumber"></label><input asp-for="PhoneNumber" /><span asp-validation-for="PhoneNumber"></span></div><div class="two-col"><div class="field"><label asp-for="Password"></label><input asp-for="Password" /><span asp-validation-for="Password"></span></div><div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" /><span asp-validation-for="ConfirmPassword"></span></div></div><button class="button primary full" type="submit">Create account</button></form><p class="form-note">Already registered? <a asp-action="Login">Login here</a>.</p></div></div></section>
