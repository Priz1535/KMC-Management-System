@model EventViewModel
@{
    ViewData["Title"] = "Delete Event";
}
<section class="section"><div class="container narrow"><div class="form-card"><span class="eyebrow danger-text">Delete event</span><h1>@Model.EventName</h1><p>This will permanently remove the event and its participant registrations. Confirm only if you are sure.</p><div class="summary-box"><strong>@Model.EventDate.ToString("dd MMMM yyyy")</strong><span>@Model.VenueName</span><span>@Model.RegisteredCount registration(s)</span></div><form asp-action="DeleteEvent" asp-route-id="@Model.EventID" method="post">@Html.AntiForgeryToken()<div class="button-row"><button class="button danger" type="submit">Delete event</button><a class="button ghost" asp-action="Dashboard">Keep event</a></div></form></div></div></section>
