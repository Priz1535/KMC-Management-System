@{
    var organizerName = Context.Session.GetString("OrganizerName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KMC Events</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="container nav-wrap">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">KMC</span>
                <span>Kandy City Events</span>
            </a>
            <nav class="main-nav">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Events" asp-action="Index">Browse Events</a>
                @if (!string.IsNullOrWhiteSpace(organizerName))
                {
                    <a asp-controller="Organizer" asp-action="Dashboard">Organizer Dashboard</a>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="inline-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="link-button">Logout (@organizerName)</button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login">Organizer Login</a>
                    <a class="nav-primary" asp-controller="Account" asp-action="Register">Register Organizer</a>
                }
            </nav>
        </div>
    </header>

    <main class="page-main">
        <div class="container">
            @if (TempData["Success"] is string success)
            {
                <div class="alert success">@success</div>
            }
            @if (TempData["Error"] is string error)
            {
                <div class="alert error">@error</div>
            }
        </div>
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container footer-wrap">
            <div>
                <strong>KMC Event Management System</strong>
                <p>Central event information and registration for Kandy.</p>
            </div>
            <span>Service-Oriented Computing Project</span>
        </div>
    </footer>
</body>
</html>
